{
  "name": "ocd-web-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-seo.mjs && vite build",
    "start": "node server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-dist.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "test:unit": "node --test tests/unit.test.mjs",
    "test": "playwright test",
    "check": "npm run typecheck && npm run test:unit && npm run build && npm run verify"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.66.0",
    "nodemailer": "^10.4.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^7.3.7"
  }
}
